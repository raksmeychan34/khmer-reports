<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_purchase_request_khmer_header" model="ir.actions.report">
        <field name="name">Purchase Request (Khmer - With Header)</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">khmer_reports.report_purchase_request_header</field>
        <field name="report_file">khmer_reports.report_purchase_request_header</field>
        <field name="print_report_name">'Purchase Request - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_purchase_request_khmer_no_header" model="ir.actions.report">
        <field name="name">Purchase Request (Khmer - No Header)</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">khmer_reports.report_purchase_request_no_header</field>
        <field name="report_file">khmer_reports.report_purchase_request_no_header</field>
        <field name="print_report_name">'Purchase Request - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Shared content — used by both wrappers below. NOTE: no font-face, no company
         header block here anymore — that's handled per-wrapper now, since the
         with-header layout renders its own header and would duplicate it. -->
    <template id="report_purchase_request_document">
        <div class="page">
            <br/>
            <h4 class="text-center"><strong><span>សំណើសុំទិញ</span></strong></h4>
            <h4 class="text-center"><strong><span>PURCHASE REQUEST</span></strong></h4>

            <div class="row">
                <div class="col-7">
                    <div class="row">
                        <div class="col-4"><div class="erp-text">PR No.</div></div>
                        <div class="col-8"><div class="erp-text">: <span t-field="o.name"/></div></div>
                    </div>
                    <div class="row">
                        <div class="col-4"><div class="erp-text">Requester</div></div>
                        <div class="col-8"><div class="erp-text">: <span t-esc="o.requested_by.name"/></div></div>
                    </div>
                    <!-- Project Name / Project Code: not in the purchase.request module, see Part 1 -->
                </div>
                <div class="col-5">
                    <div class="row">
                        <div class="col-5"><div class="erp-text">Date</div></div>
                        <div class="col-7"><div class="erp-text">: <span t-esc="o.date_start" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/></div></div>
                    </div>
                    <div class="row">
                        <div class="col-5"><div class="erp-text">Warehouse</div></div>
                        <div class="col-7"><div class="erp-text">: <span t-esc="o.picking_type_id.warehouse_id.name"/></div></div>
                    </div>
                    <div class="row">
                        <div class="col-5"><div class="erp-text">Note</div></div>
                        <div class="col-7"><div class="erp-text">: <span t-field="o.description"/></div></div>
                    </div>
                </div>
            </div>

            <table class="table table-sm o_main_table" name="pr_line_table">
                <thead>
                    <tr class="erp-border">
                        <th class="text-center erp-text erp-border erp-table-header" style="width:5%">No.</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:14%">Item Code</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:19%">Item Name</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:19%">Item Description</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:9%">QTY Request</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:7%">UoM</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:12%">Unit Price</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:15%">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.line_ids" t-as="line">
                        <tr class="erp-border">
                            <td class="erp-center erp-text erp-border"><t t-esc="line_index + 1"/></td>
                            <td class="erp-text erp-border"><span t-field="line.product_id.default_code"/></td>
                            <td class="erp-text erp-border"><span t-field="line.product_id.name"/></td>
                            <td class="erp-text erp-border"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.product_qty"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.product_uom_id"/></td>
                            <!-- purchase.request.line only stores a total estimated_cost, no separate unit price field,
                                 so unit price is derived here for display purposes only -->
                            <td class="erp-right erp-text erp-border">
                                <span t-esc="(line.estimated_cost / line.product_qty) if line.product_qty else 0.0" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                            </td>
                            <td class="erp-right erp-text erp-border"><span t-field="line.estimated_cost"/></td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr class="erp-border">
                        <th colspan="4" class="text-end erp-text erp-border">Total:</th>
                        <th class="erp-center erp-text erp-border"><span t-esc="sum(l.product_qty for l in o.line_ids)"/></th>
                        <th class="erp-border"></th>
                        <th class="erp-border"></th>
                        <th class="erp-right erp-text erp-border"><span t-field="o.estimated_cost"/></th>
                    </tr>
                </tfoot>
            </table>

            <div class="row" style="margin-top: 60px;">
                <div class="col-6">
                    <div style="border-bottom: 1px solid black; margin-top: 60px; margin-bottom: 5px;"/>
                    <div class="erp-text text-center">Prepared by</div>
                    <div class="erp-text">Name: <span t-esc="o.requested_by.name"/></div>
                    <div class="erp-text">Date: <span t-esc="o.date_start" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/></div>
                </div>
                <div class="col-6">
                    <div style="border-bottom: 1px solid black; margin-top: 60px; margin-bottom: 5px;"/>
                    <div class="erp-text text-center">Checked And Approved by</div>
                    <div class="erp-text">Name: <span t-esc="o.assigned_to.name"/></div>
                    <div class="erp-text">Date: </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Wrapper 1: WITH header — external_layout_template_center already draws the
         full company header itself, so we do NOT add our own header block here. -->
    <template id="report_purchase_request_header">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="display_header" t-value="True"/>
                <t t-set="display_footer" t-value="True"/>
                <link rel="stylesheet" href="/report_layout_template/static/src/css/font.css"/>
                <t t-if="not company">
                    <t t-if="company_id"><t t-set="company" t-value="company_id"/></t>
                    <t t-elif="o and 'company_id' in o and o.company_id.sudo()"><t t-set="company" t-value="o.company_id.sudo()"/></t>
                    <t t-else="else"><t t-set="company" t-value="res_company"/></t>
                </t>
                <style>
                    .erp-text { font-size: 12px; font-family: Battambang; padding-bottom: 3px; }
                </style>
                <t t-call="report_layout_template.external_layout_template_center">
                    <t t-call="khmer_reports.report_purchase_request_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Wrapper 2: NO header — this layout's header is intentionally blank, so we
         draw our own compact letterhead block before handing off to the document. -->
    <template id="report_purchase_request_no_header">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="display_header" t-value="True"/>
                <t t-set="display_footer" t-value="True"/>
                <link rel="stylesheet" href="/report_layout_template/static/src/css/font.css"/>
                <t t-if="not company">
                    <t t-if="company_id"><t t-set="company" t-value="company_id"/></t>
                    <t t-elif="o and 'company_id' in o and o.company_id.sudo()"><t t-set="company" t-value="o.company_id.sudo()"/></t>
                    <t t-else="else"><t t-set="company" t-value="res_company"/></t>
                </t>
                <t t-call="report_layout_template.external_layout_erp_cambodia_no_head">
                    <style>
                        .erp-title { font-size: 20px; font-family: Moul; padding-bottom: 3px; font-weight: bold; }
                        .erp-text { font-size: 12px; font-family: Battambang; padding-bottom: 3px; }
                        .erp-title-en { font-size: 18px; }
                    </style>
                    <div class="row mb8">
                        <div class="col-4 mb2">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height: 150px; margin-top:10px;"/>
                        </div>
                        <div class="col-8 mb6" style="margin-top:10px;">
                            <h3 class="mt0 erp-title text-left" t-field="company.kh_name"/>
                            <h4 class="mt0 text-left erp-title-en" t-field="company.name"/>
                        </div>
                    </div>
                    <div style="border-bottom: 1px solid black;"/>
                    <t t-call="khmer_reports.report_purchase_request_document"/>
                </t>
            </t>
        </t>
    </template>

</odoo>