<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_purchase_request_khmer" model="ir.actions.report">
        <field name="name">Purchase Request (Khmer)</field>
        <field name="paperformat_id" ref="khmer_reports.paperformat"/>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">khmer_reports.report_purchase_request</field>
        <field name="report_file">khmer_reports.report_purchase_request</field>
        <field name="print_report_name">'Purchase Request - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_purchase_request_document">
        <div class="page">
            <br/>
            <h4 class="erp-doc-title"><span>PURCHASE REQUEST</span></h4>

            <div class="row">
                <div class="col-7">
                    <div class="row">
                        <div class="col-4"><div class="erp-text erp-label">PR No.</div></div>
                        <div class="col-8"><div class="erp-text">: <span t-field="o.name"/></div></div>
                    </div>
                    <div class="row">
                        <div class="col-4"><div class="erp-text erp-label">Project Name</div></div>
                        <div class="col-8"><div class="erp-text">: </div></div>
                    </div>
                    <div class="row">
                        <div class="col-4"><div class="erp-text erp-label">Project Code</div></div>
                        <div class="col-8"><div class="erp-text">: </div></div>
                    </div>
                    <div class="row">
                        <div class="col-4"><div class="erp-text erp-label">Requester</div></div>
                        <div class="col-8"><div class="erp-text">: <span t-esc="o.requested_by.name"/></div></div>
                    </div>
                </div>
                <div class="col-5">
                    <div class="row">
                        <div class="col-5"><div class="erp-text erp-label">Date</div></div>
                        <div class="col-7"><div class="erp-text">: <span t-esc="o.date_start" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/></div></div>
                    </div>
                    <div class="row">
                        <div class="col-5"><div class="erp-text erp-label">Warehouse</div></div>
                        <div class="col-7"><div class="erp-text">: <span t-esc="o.picking_type_id.warehouse_id.name"/></div></div>
                    </div>
                    <div class="row">
                        <div class="col-5"><div class="erp-text erp-label">Note</div></div>
                        <div class="col-7"><div class="erp-text">: <span t-field="o.description"/></div></div>
                    </div>
                </div>
            </div>

            <table class="table table-sm o_main_table erp-border" name="pr_line_table" style="margin-top:6px;">
                <thead>
                    <tr class="erp-border">
                        <th class="text-center erp-text erp-border erp-table-header" style="width:5%">No.</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:14%">Item Code</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:19%">Item Name</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:19%">Item Description</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:9%">QTY Request</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:7%">UoM</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:12%">Unit Price</th>
                        <th class="text-center erp-text erp-border erp-table-header" style="width:15%">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.line_ids" t-as="line">
                        <tr class="erp-border">
                            <td class="erp-center erp-text erp-border"><t t-esc="line_index + 1"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.product_id.default_code"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.product_id.name"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.product_qty"/></td>
                            <td class="erp-center erp-text erp-border"><span t-field="line.product_uom_id"/></td>
                            <td class="erp-center erp-text erp-border">
                                <span t-esc="(line.estimated_cost / line.product_qty) if line.product_qty else 0.0" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                            </td>
                            <td class="erp-right erp-text erp-border"><span t-field="line.estimated_cost"/></td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr class="erp-border">
                        <th colspan="4" class="text-end erp-text erp-border">Total:</th>
                        <th class="erp-center erp-text erp-border"><span t-esc="sum(l.product_qty for l in o.line_ids)"/></th>
                        <th class="erp-border"></th>
                        <th class="erp-border"></th>
                        <th class="erp-right erp-text erp-border"><span t-field="o.estimated_cost"/></th>
                    </tr>
                </tfoot>
            </table>

            <table class="table table-sm erp-border" style="margin-top:20px; margin-bottom:0; table-layout:fixed;">
                <tr class="erp-border">
                    <td class="erp-text erp-border text-center" style="height:80px; vertical-align:top;"><strong>Prepared by</strong></td>
                    <td class="erp-text erp-border text-center" style="height:80px; vertical-align:top;"><strong>Checked And Approved by</strong></td>
                </tr>
                <tr class="erp-border">
                    <td class="erp-text erp-border">Name: <span t-esc="o.requested_by.name"/><br/>Date: <span t-esc="o.date_start" t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"/></td>
                    <td class="erp-text erp-border">Name: <span t-esc="o.assigned_to.name"/><br/>Date: </td>
                </tr>
            </table>

            <div class="erp-footer-fixed">
                <div class="row">
                    <div class="col-6">
                        <div class="erp-text erp-label">ADDRESS</div>
                        <div class="erp-text">
                            <span t-esc="company.city"/><t t-if="company.city and company.country_id">,</t>
                            <span t-esc="company.country_id.name"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="erp-text erp-label">CONTACT</div>
                        <div class="erp-text">T. <span t-esc="company.phone"/></div>
                    </div>
                </div>
                <div class="row" style="margin-top: 6px;">
                    <div class="col text-center"><img src="/khmer_reports/static/src/img/design_build.png" style="width:100%; max-width:70px;"/></div>
                    <div class="col text-center"><img src="/khmer_reports/static/src/img/electrical.png" style="width:100%; max-width:70px;"/></div>
                    <div class="col text-center"><img src="/khmer_reports/static/src/img/mechanical.png" style="width:100%; max-width:70px;"/></div>
                    <div class="col text-center"><img src="/khmer_reports/static/src/img/water_systems.png" style="width:100%; max-width:70px;"/></div>
                    <div class="col text-center"><img src="/khmer_reports/static/src/img/fire_security.png" style="width:100%; max-width:70px;"/></div>
                    <div class="col text-center"><img src="/khmer_reports/static/src/img/maintenance_warranty.png" style="width:100%; max-width:70px;"/></div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="display_header" t-value="True"/>
                <t t-set="display_footer" t-value="True"/>
                <link rel="stylesheet" href="/report_layout_template/static/src/css/font.css"/>
                <t t-if="not company">
                    <t t-if="company_id"><t t-set="company" t-value="company_id"/></t>
                    <t t-elif="o and 'company_id' in o and o.company_id.sudo()"><t t-set="company" t-value="o.company_id.sudo()"/></t>
                    <t t-else="else"><t t-set="company" t-value="res_company"/></t>
                </t>
                <t t-call="report_layout_template.external_layout_erp_cambodia_no_head">
                    <style>
                        .erp-title { font-size: 22px; font-family: 'Moul', 'Khmer OS Muol Light', serif; font-weight: bold; color: #003399; padding-bottom: 2px; }
                        .erp-title-en { font-size: 13px; font-family: 'Times New Roman', Battambang, serif; color: #003399; letter-spacing: 3px; }
                        .erp-text { font-size: 10px; font-family: 'Times New Roman', Battambang, serif; padding-bottom: 2px; }
                        .erp-label { font-weight: bold; }
                        .erp-doc-title { font-size: 16px; font-weight: bold; color: #003399; text-align: center; margin: 6px 0 12px 0; font-family: 'Times New Roman', Battambang, serif; }
                        .erp-table-header { background-color: #d9d9d9; }
                        .erp-footer-fixed { position: fixed; bottom: 0; left: 0; right: 0; }
                    </style>
                    <div class="row mb8">
                        <div class="col-4 mb2">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="height:80px; width:auto; margin-top:8px;"/>
                        </div>
                        <div class="col-8 mb6" style="margin-top:10px;">
                            <h3 class="mt0 erp-title text-left" t-field="company.kh_name"/>
                            <h4 class="mt0 text-left erp-title-en" t-field="company.name"/>
                        </div>
                    </div>
                    <div style="border-bottom: 1px solid black;"/>
                    <t t-call="khmer_reports.report_purchase_request_document"/>
                </t>
            </t>
        </t>
    </template>

</odoo>